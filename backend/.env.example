# Environment Variables for CatalogIA

# PrestaShop Configuration
PRESTASHOP_BASE_URL=https://your-shop.com
PRESTASHOP_API_KEY=your-prestashop-webservice-api-key
PRESTASHOP_LANGUAGE=1
PRESTASHOP_CURRENCY=1

# Application Configuration
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
DRY_RUN=true
UPLOAD_DIR=./uploads
UPLOAD_TEMP_DIR=./uploads/temp
UPLOAD_IMAGES_DIR=./uploads/images
LOG_DIR=./logs

# File Upload Limits
MAX_FILE_SIZE=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# AI Provider Configuration
AI_PROVIDER=openai
AI_API_KEY=your-openai-api-key
AI_MODEL=gpt-4-turbo
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.7
AI_TIMEOUT=30000
AI_RETRY_COUNT=3

# Image Processing
MAX_IMAGES_PER_PRODUCT=5
IMAGE_MIN_SIZE=1024
IMAGE_MIN_RESOLUTION=300
IMAGE_DPI_MIN=72

# CSV Processing
CSV_DEFAULT_ENCODING=utf8
CSV_DELIMITER=,
CSV_SKIP_EMPTY_ROWS=true
CSV_HEADERS_CASE_SENSITIVE=false

# Product Validation
VALIDATION_REQUIRED_FIELDS=name,price,quantity
VALIDATION_EAN_LENGTH=13
VALIDATION_PRICE_MIN=0
VALIDATION_QUANTITY_MIN=0

# Synchronization
SYNC_BATCH_SIZE=50
SYNC_RETRY_COUNT=3
SYNC_RETRY_DELAY=1000
SYNC_TIMEOUT=300000

# AI Text Generation
AI_TEXT_FIELDS=name,description,description_short,meta_title,meta_description
AI_TEXT_MIN_LENGTH=10
AI_TEXT_MAX_LENGTH=500
AI_TEXT_SEO_OPTIMIZED=true
AI_TEXT_PREFIX="Based on the product data, create a descriptive"

# Image Matching
IMAGE_MATCHING_EAN_FIELD=ean
IMAGE_MATCHING_REFERENCE_FIELD=reference
IMAGE_MATCHING_FILENAME_PATTERNS=*,EAN*,REF*
IMAGE_MATCHING_WEIGHT_EAN=0.8
IMAGE_MATCHING_WEIGHT_REFERENCE=0.3
IMAGE_MATCHING_WEIGHT_MANUAL=0.5

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined
LOG_MAX_SIZE=10485760
LOG_MAX_FILES=5
LOG_INCLUDE_TIMESTAMP=true
LOG_INCLUDE_LEVEL=true

# Security
SESSION_SECRET=your-session-secret-key
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Monitoring
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true
