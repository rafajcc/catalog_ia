{
  "name": "catalog-ia-backend",
  "version": "1.0.0",
  "description": "Backend API for CatalogIA - PrestaShop Product Synchronization",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npx prisma generate",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/",
    "postinstall": "npm run build"
  },
  "keywords": [
    "prestashop",
    "ecommerce",
    "csv",
    "product-sync",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/cors": "^2.8.12",
    "@types/express": "^4.18.2",
    "@types/express-fileupload": "^1.5.0",
    "@types/fs-extra": "^11.1.0",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^29.5.0",
    "@types/json2xml": "^2.0.1",
    "@types/multer": "^1.4.10",
    "@types/node": "^20.0.0",
    "@types/node-fetch": "^2.6.12",
    "@types/uuid": "^9.0.0",
    "cors": "^2.8.12",
    "date-fns": "^2.29.0",
    "express": "^4.18.2",
    "express-fileupload": "^1.5.0",
    "express-rate-limit": "^6.10.0",
    "fs-extra": "^11.1.0",
    "helmet": "^7.0.0",
    "jest": "^29.5.0",
    "json2xml": "^2.0.1",
    "multer": "^1.4.5",
    "nanoid": "^5.0.0",
    "node-fetch": "^2.6.12",
    "prettier": "^3.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "ts-jest": "^29.1.0",
    "ts-node-dev": "^2.0.0"
  },
  "engines": {
    "node": ">= 18.0.0",
    "npm": ">= 8.0.0"
  },
  "browserslist": {
    "production": [
      "> 1%",
      "last 2 versions",
      "not dead"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
